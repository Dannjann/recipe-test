    "steps": [
      {
        "id": "stp-001-1",
        "number": 1,
        "text": "Bring a large pan of well-salted water to the boil and drop in the spaghetti.",
        "image_url": "https://api.example.com/api/v1/images/spaghetti-alla-carbonara-step-1.png",
        "duration_seconds": 600
      },
      {
        "id": "stp-001-2",
        "number": 2,
        "text": "While it cooks, dice the bacon and render it slowly in a dry frying pan until the fat runs and the edges crisp.",
        "image_url": null,
        "duration_seconds": 480
      },
      {
        "id": "stp-001-3",
        "number": 3,
        "text": "Beat the egg yolks with the grated pecorino and a heavy grind of black pepper until it forms a thick paste.",
        "image_url": null,
        "duration_seconds": null
      },
      {
        "id": "stp-001-4",
        "number": 4,
        "text": "Drain the pasta, reserving a mugful of the cooking water, and tip it into the pan with the bacon off the heat.",
        "image_url": null,
        "duration_seconds": null
      },
      {
        "id": "stp-001-5",
        "number": 5,
        "text": "Stir the yolk mixture through immediately, loosening with splashes of pasta water until the sauce coats each strand.",
        "image_url": "https://api.example.com/api/v1/images/spaghetti-alla-carbonara-step-5.png",
        "duration_seconds": 60
      },
      {
        "id": "stp-001-6",
        "number": 6,
        "text": "Serve at once with more pecorino and pepper — it stiffens as it cools.",
        "image_url": null,
        "duration_seconds": null
      }
    ]
