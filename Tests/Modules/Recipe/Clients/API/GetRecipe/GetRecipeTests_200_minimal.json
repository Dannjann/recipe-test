      {
        "id": "stp-021-1",
        "number": 1,
        "text": "Prick the potatoes all over, rub them with salt, and bake until the skins are crisp and they give under pressure.",
        "image_url": "https://api.example.com/api/v1/images/kumpir-step-1.png",
        "duration_seconds": 4200
      },
      {
        "id": "stp-021-2",
        "number": 2,
        "text": "Split each one lengthways without cutting through the base.",
        "image_url": null,
        "duration_seconds": null
      },
      {
        "id": "stp-021-3",
        "number": 3,
        "text": "Work the butter and grated cheese into the hot flesh with a fork, right there in the skin, until smooth and fluffy.",
